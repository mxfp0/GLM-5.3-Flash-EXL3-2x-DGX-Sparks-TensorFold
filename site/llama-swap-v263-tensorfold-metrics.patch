@@ -547,6 +554,22 @@ func buildMetrics(modelID string, start time.Time, inputTokens, outputTokens, ca
 		tokensPerSecond = 1000 / meanInterTokenLatency.Float()
 	}
 
+	if promptPerSecond < 0 && responseMetrics.Get("prefill_s").Exists() {
+		cachedForRate := cachedTokens
+		if cachedForRate < 0 {
+			if cached := responseMetrics.Get("cached"); cached.Type == gjson.Number {
+				cachedForRate = cached.Int()
+			}
+		}
+		if cachedForRate >= 0 && cachedForRate <= inputTokens {
+			promptPerSecond = tensorfoldRate(inputTokens-cachedForRate, responseMetrics.Get("prefill_s"))
+		}
+	}
+	if tokensPerSecond < 0 {
+		// TensorFold samples the first output token during prefill.
+		tokensPerSecond = tensorfoldRate(outputTokens-1, responseMetrics.Get("decode_s"))
+	}
+
 	return ActivityLogEntry{
 		Timestamp: time.Now(),
 		Model:     modelID,
@@ -682,3 +705,18 @@ func (w *responseBodyCopier) Hijack() (net.Conn, *bufio.ReadWriter, error) {
 
 func (w *responseBodyCopier) Status() int          { return w.status }
 func (w *responseBodyCopier) StartTime() time.Time { return w.start }
+
+func tensorfoldRate(tokens int64, seconds gjson.Result) float64 {
+	if tokens <= 0 || seconds.Type != gjson.Number {
+		return -1
+	}
+	duration := seconds.Float()
+	if duration <= 0 || math.IsInf(duration, 0) || math.IsNaN(duration) {
+		return -1
+	}
+	rate := float64(tokens) / duration
+	if math.IsInf(rate, 0) || math.IsNaN(rate) {
+		return -1
+	}
+	return rate
+}
