+
+func TestMetricsMonitor_TensorFoldRates(t *testing.T) {
+	for _, tc := range []struct {
+		name, usage, metadata string
+		prefill, decode       float64
+	}{
+		{"existing rates take precedence", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_per_sec":123,"completion_tokens_per_sec":45,"prompt_tokens_details":{"cached_tokens":20}`, `"prefill_s":2,"decode_s":1`, 123, 45},
+		{"partial cache", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":20}`, `"prefill_s":2,"decode_s":1`, 40, 10},
+		{"native cache fallback", `"prompt_tokens":100,"completion_tokens":11`, `"prefill_s":2,"decode_s":1,"cached":20`, 40, 10},
+		{"full cache", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":100}`, `"prefill_s":2,"decode_s":1`, -1, 10},
+		{"invalid cache", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":101}`, `"prefill_s":2,"decode_s":1`, -1, 10},
+		{"unknown cache", `"prompt_tokens":100,"completion_tokens":11`, `"prefill_s":2,"decode_s":1`, -1, 10},
+		{"one output", `"prompt_tokens":100,"completion_tokens":1,"prompt_tokens_details":{"cached_tokens":0}`, `"prefill_s":2,"decode_s":1`, 50, -1},
+		{"missing timings", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":0}`, `"cached":0`, -1, -1},
+		{"zero timings", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":0}`, `"prefill_s":0,"decode_s":0`, -1, -1},
+		{"nonnumeric timings", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":0}`, `"prefill_s":"2","decode_s":null`, -1, -1},
+		{"nonfinite timings", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":0}`, `"prefill_s":1e309,"decode_s":1e309`, -1, -1},
+		{"overflow rates", `"prompt_tokens":100,"completion_tokens":11,"prompt_tokens_details":{"cached_tokens":0}`, `"prefill_s":1e-309,"decode_s":1e-309`, -1, -1},
+	} {
+		for _, stream := range []bool{false, true} {
+			t.Run(fmt.Sprintf("%s/stream=%v", tc.name, stream), func(t *testing.T) {
+				body := `{"usage":{` + tc.usage + `},"tensorfold":{` + tc.metadata + `}}`
+				contentType := "application/json"
+				if stream {
+					contentType = "text/event-stream"
+					body = "data: " + body + "\n\ndata: [DONE]\n\n"
+				}
+				mm := newTestMetricsMonitor(t, logmon.NewWriter(io.Discard), 10, 0)
+				r := httptest.NewRequest(http.MethodPost, "/v1/chat/completions", nil)
+				w := httptest.NewRecorder()
+				copier := newBodyCopier(w)
+				copier.Header().Set("Content-Type", contentType)
+				copier.WriteHeader(http.StatusOK)
+				copier.Write([]byte(body))
+				mm.record("m", r, copier, captureAll, nil, nil)
+				entries := metricsEntries(t, mm)
+				if len(entries) != 1 {
+					t.Fatalf("entries = %d, want 1", len(entries))
+				}
+				got := entries[0].Tokens
+				if got.PromptPerSecond != tc.prefill || got.TokensPerSecond != tc.decode {
+					t.Fatalf("rates = %v/%v, want %v/%v", got.PromptPerSecond, got.TokensPerSecond, tc.prefill, tc.decode)
+				}
+				if w.Body.String() != body {
+					t.Fatal("response body changed")
+				}
+			})
+		}
+	}
+}
